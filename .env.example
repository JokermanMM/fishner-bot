# Создайте бота через @BotFather и вставьте токен только в локальный .env.
BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BOT_MODE=polling
FRIEND_INVITE_CODE=
WEBHOOK_SECRET=
# Для Render адрес определится автоматически из RENDER_EXTERNAL_HOSTNAME.
PUBLIC_URL=
PORT=3000
TIME_ZONE=Europe/Moscow
LOG_LEVEL=info
